# Copy to .env (gitignored) and edit. Read by the build (app/vite.config.ts) and by tools/build_ipk.sh and tools/deploy.sh.
# A variable set in the environment wins over this file.

# The app id and the name on the tile. The dev build installs beside stable because the id differs.
# Stable: LUMEN_APP_ID=com.samrenfrew.lumen and LUMEN_APP_TITLE=Home
LUMEN_APP_ID=com.samrenfrew.lumen.dev
LUMEN_APP_TITLE=Home Dev

# The TV, for npm run deploy: an ssh config alias, or root@<tv-ip> (rooted, SSH on).
LUMEN_TV_HOST=root@192.0.2.10

# A TV in Developer Mode instead (not rooted), for tools/devmode.sh: its address, and a passphrase-free copy of the key the
# Developer Mode app serves (README.md, "A TV in Developer Mode").
# LUMEN_TV_IP=192.0.2.10
# LUMEN_TV_KEY=/path/to/webos_rsa_nopass

# 0 builds without app/private/ (your icon tiles, wallpapers and font), which is what a public release is. Default: included when present.
# LUMEN_PRIVATE=0

# Chrome or Chromium for the screenshot and icon scripts in tools/ (default: Google Chrome on macOS).
# CHROME=/usr/bin/chromium
