{
  "id": "com.samrenfrew.lumen.saver",
  "version": "1.0.0",
  "vendor": "samrenfrew",
  "type": "web",
  "main": "saver.html",
  "title": "Lumen Screensaver",
  "appDescription": "Your photos over the app you are watching when the TV's screensaver starts, so the app is where you left it after.",
