#!/bin/sh
# webosbrew boot hook: start the Home-button watcher (see /var/lib/homehook/watch.sh) and the Stadia watcher (stadia.sh), and run the
# Home and power-on guard (home-setup.sh guard: undoes both if Lumen is uninstalled). Never blocks boot.
# Uninstall: rm /var/lib/webosbrew/init.d/60-homehook; kill the watchers (killall watch.sh stadia.sh).
export PATH="/bin:/sbin:/usr/bin:/usr/sbin:$PATH"
start() {
  [ -x "$1" ] || return 0
  # already running? Checked in /proc: plain ps on webOS 25 only lists processes on the current terminal, so it never saw the watcher.
  for p in /proc/[0-9]*; do
    case "$({ tr "\0" " " < $p/cmdline; } 2>/dev/null)" in "/bin/sh $1"*|"sh $1"*) return 0 ;; esac
  done
  setsid nohup "$1" </dev/null >/dev/null 2>&1 &
}
start /var/lib/homehook/watch.sh
start /var/lib/homehook/stadia.sh
[ -f /var/lib/homehook/home-setup.sh ] && { setsid nohup sh /var/lib/homehook/home-setup.sh guard </dev/null >/dev/null 2>&1 & }
exit 0
